{
    "name": "softspring/polymorphic-form-type",
    "description": "Symfony Polymorphic Form Type",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "softspring/collection-form-type": "^6.0@dev",
        "symfony/form": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "doctrine/orm": "^2.11 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\PolymorphicFormType\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\PolymorphicFormType\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
